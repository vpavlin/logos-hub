#!/usr/bin/env python3
"""logos-hub — run a set of logos-core modules headless and drive them from a generated CLI.

A thin wrapper over `logoscore` (the daemon/client runtime): it adds *profiles* (a declarative
set of modules + env + module dir to bring up together, in an isolated config dir) and a nicer
UX (auto load-module, per-module `describe` from the module's own API, pretty JSON, watch).

Nothing here is app-specific — it drives ANY logos-core module (kym_core, qaku_core, scala,
loam_core, delivery_module, ...). Loam apps are just some of the tenants.

Config dir per profile keeps hubs isolated (so one doesn't read another's registry). The real
work — load-module / call / module-info / watch — is logoscore's; this makes it ergonomic.
"""
import argparse, json, os, subprocess, sys, time
from pathlib import Path

LOGOSCORE = os.environ.get("LOGOSCORE", str(Path.home() / "logoscore-new/result/bin/logoscore"))
STATE = Path(os.environ.get("LOGOS_HUB_STATE", Path.home() / ".logos-hub"))
PROFILE_DIRS = [Path(__file__).resolve().parent / "profiles", STATE / "profiles"]

def die(msg, code=1):
    print(f"logos-hub: {msg}", file=sys.stderr); sys.exit(code)

def find_profile(name):
    for d in PROFILE_DIRS:
        p = d / f"{name}.json"
        if p.exists():
            prof = json.loads(p.read_text()); prof.setdefault("name", name); return prof
    die(f"profile '{name}' not found (looked in: {', '.join(str(d) for d in PROFILE_DIRS)})")

def paths(prof):
    base = STATE / "run" / prof["name"]
    return {"cfg": base / "cfg", "data": base / "data", "log": base / "daemon.log"}

def lc_env(prof):
    p = paths(prof)
    e = dict(os.environ)
    e["LOGOSCORE_CONFIG_DIR"] = str(p["cfg"])
    e.update({k: str(v) for k, v in prof.get("env", {}).items()})
    # per-module KYM_CORE_DATA etc. can be templated with {data}
    for k, v in list(e.items()):
        if isinstance(v, str) and "{data}" in v:
            e[k] = v.replace("{data}", str(p["data"]))
    return e

# ── logos-logoscore-py backend ─────────────────────────────────────────────
# When the official client (github.com/logos-co/logos-logoscore-py) is importable,
# route logos-hub's client operations through it instead of re-shelling out — so we
# inherit its maintenance + `logoscore → logosctl` migration. It attaches to the
# daemon logos-hub launched, by config dir (no endpoints). Falls back to subprocess
# when the package isn't installed, so the single-file zero-dep path still works.
try:
    from logoscore import LogoscoreClient as _LClient
    _HAVE_LIB = True
except Exception:
    _HAVE_LIB = False

class _R:  # a subprocess.run-like result the cmd_* handlers already expect
    def __init__(self, stdout="", stderr="", returncode=0):
        self.stdout, self.stderr, self.returncode = stdout, stderr, returncode

def _client(prof):
    cfg = paths(prof)["cfg"]; tok = None
    tf = cfg / "client" / "auto.json"
    try:
        if tf.exists(): tok = json.loads(tf.read_text()).get("token")
    except Exception: pass
    return _LClient(binary=LOGOSCORE, config_dir=cfg, token=tok)

def _lib_lc(prof, args):
    """Route a recognized logoscore subcommand through the py client; None if unhandled."""
    if not args: return None
    cmd = args[0]
    try:
        c = _client(prof)
        if cmd == "status":       return _R(json.dumps(c.status()))
        if cmd == "list-modules": return _R(json.dumps(c.list_modules(loaded=("--loaded" in args))))
        if cmd == "module-info":  return _R(json.dumps(c.module_info(args[1])))
        if cmd == "load-module":  return _R(json.dumps(c.load_module(args[1])))
        if cmd == "stop":         c.stop(); return _R("{}")
        if cmd == "call":
            module, method, rest = args[1], args[2], list(args[3:])
            # logos-hub's typed path passes ONE JSON object of named params; the client
            # takes positionals, so map it back to declared order via module-info.
            if len(rest) == 1 and rest[0].lstrip()[:1] == "{":
                obj = json.loads(rest[0])
                params = next((m.get("parameters", []) for m in c.module_info(module).get("methods", [])
                               if m.get("name") == method), [])
                rest = [obj[p["name"]] for p in params if p["name"] in obj]
            res = c.call(module, method, *rest)
            return _R(res if isinstance(res, str) else json.dumps(res, default=str))
    except Exception as e:
        return _R("", str(e), 1)
    return None

def lc(prof, *args, capture=True, check=False, env_extra=None):
    if _HAVE_LIB and capture and not env_extra:
        r = _lib_lc(prof, args)
        if r is not None:
            if check and r.returncode != 0:
                die(f"logoscore {' '.join(args)} failed: {(r.stderr or r.stdout).strip()}")
            return r
    e = lc_env(prof)
    if env_extra: e.update({k: str(v) for k, v in env_extra.items()})
    r = subprocess.run([LOGOSCORE, *args], env=e,
                       capture_output=capture, text=True)
    if check and r.returncode != 0:
        die(f"logoscore {' '.join(args)} failed (rc={r.returncode}): {(r.stderr or r.stdout).strip()}")
    return r

def jprint(s):
    s = (s or "").strip()
    try:
        obj = json.loads(s)
        # unwrap a {"result":"<json-string>"} envelope one level for readability
        if isinstance(obj, dict) and isinstance(obj.get("result"), str):
            try: obj["result"] = json.loads(obj["result"])
            except Exception: pass
        print(json.dumps(obj, indent=2, sort_keys=True))
    except Exception:
        print(s)

# ---- commands ----
def cmd_up(prof, args):
    p = paths(prof); p["data"].mkdir(parents=True, exist_ok=True); p["cfg"].mkdir(parents=True, exist_ok=True)
    mdir = prof.get("modulesDir") or die("profile missing 'modulesDir'")
    lc(prof, "stop", capture=True)  # clear any stale daemon for this profile
    time.sleep(1)
    print(f"[up] starting daemon for '{prof['name']}' (modules: {mdir})")
    # daemon must run detached; its modules inherit lc_env(prof)
    e = lc_env(prof)
    with open(p["log"], "w") as logf:
        subprocess.Popen([LOGOSCORE, "-D", "-m", mdir], env=e, stdout=logf, stderr=subprocess.STDOUT)
    for _ in range(25):
        if lc(prof, "status").returncode == 0: break
        time.sleep(1)
    else:
        die("daemon did not come up; see " + str(p["log"]))
    for m in prof.get("load", []):
        r = lc(prof, "load-module", m)
        ok = r.returncode == 0
        print(f"[up] load {m}: {'ok' if ok else 'FAILED'} {r.stdout.strip() or r.stderr.strip()}")
    print(f"[up] '{prof['name']}' ready. `logos-hub ls {prof['name']}` / `describe` / `call` / `watch`.")

def cmd_down(prof, args):
    lc(prof, "stop"); print(f"[down] stopped '{prof['name']}'")

def cmd_status(prof, args): jprint(lc(prof, "status", "--json").stdout)
def cmd_ls(prof, args):     jprint(lc(prof, "list-modules", "--json").stdout)
def cmd_logs(prof, args):
    p = paths(prof); print(p["log"].read_text()[-4000:] if p["log"].exists() else "(no log yet)")

def cmd_describe(prof, args):
    # the "generated CLI": surface a module's own API from logoscore module-info,
    # rendered as typed call signatures (the flags `call` and completion accept).
    if getattr(args, "json", False):  # full machine-readable schema (params+returnType+events) in one call
        r = lc(prof, "module-info", args.module, "--json")
        return jprint(r.stdout or r.stderr)
    sc = module_schema(prof, args.module)
    if not sc:
        r = lc(prof, "module-info", args.module, "--json")
        return jprint(r.stdout or r.stderr)
    print(f"{args.module} — {len(sc)} methods (call: logos-hub call {args.profile} {args.module} <method> [--flags])")
    for meth in sorted(sc):
        flags = " ".join(f"--{n} <{t}>" for n, t in sc[meth])
        print(f"  {meth} {flags}".rstrip())

# ---- typed call: named --flags coerced per the module's own parameter types ----
_QNUM = {"int","qint32","qint64","qlonglong","qulonglong","uint","uint32","uint64",
         "double","float","qreal","long","short","unsigned int"}
_QBOOL = {"bool"}
_QJSON = {"qvariantmap","qjsonobject","qvariantlist","qjsonarray","qstringlist","qvariant"}

def module_schema(prof, module):
    """{methodName: [(paramName, qtype), ...]} straight from `logoscore module-info`."""
    try:
        r = lc(prof, "module-info", module, "--json")
        d = json.loads(r.stdout); d = d.get("result", d)
        if isinstance(d, str): d = json.loads(d)
        out = {}
        for m in d.get("methods", []):
            if m.get("isInvokable", True):
                out[m["name"]] = [(p["name"], p.get("type", "QString")) for p in m.get("parameters", [])]
        return out
    except Exception:
        return {}

def _coerce(val, qtype):
    t = (qtype or "").lower()
    if t in _QBOOL: return val.lower() in ("1", "true", "yes", "on")
    if t in _QNUM:
        try: return int(val)
        except ValueError:
            try: return float(val)
            except ValueError: die(f"'{val}' is not a valid {qtype}")
    if t in _QJSON:
        try: return json.loads(val)
        except Exception: die(f"value for a {qtype} param must be JSON, got: {val}")
    return val  # QString / unknown → string

def _emit_call(prof, module, method, call_args, dry_run):
    """Either show the exact logoscore invocation (--dry-run) or run it."""
    if dry_run:
        return jprint(json.dumps({"call": {"module": module, "method": method},
                                  "args": [json.loads(a) if a[:1] in "[{\"" else a for a in call_args],
                                  "logoscore": ["call", module, method, *call_args]}))
    r = lc(prof, "call", module, method, *call_args)
    jprint(r.stdout or r.stderr)

def cmd_call(prof, args):
    raw = list(args.args)
    dry = getattr(args, "dry_run", False)
    # Back-compat: a bare/JSON positional (not a --flag) is forwarded untouched.
    if raw and not raw[0].startswith("--"):
        return _emit_call(prof, args.module, args.method, raw, dry)
    schema = module_schema(prof, args.module)
    params = schema.get(args.method)
    if params is None:  # unknown method or daemon down → forward as-is
        return _emit_call(prof, args.module, args.method, raw, dry)
    ptypes = dict(params)
    provided, i = {}, 0
    while i < len(raw):
        tok = raw[i]
        if not tok.startswith("--"): die(f"unexpected '{tok}' — use --name value")
        if "=" in tok: name, val = tok[2:].split("=", 1)
        else:
            name = tok[2:]; i += 1
            if i >= len(raw): die(f"--{name} needs a value")
            val = raw[i]
        if name not in ptypes:
            sig = ", ".join(f"--{n} <{t}>" for n, t in params) or "(no parameters)"
            die(f"{args.module}.{args.method} has no --{name}. Parameters: {sig}")
        provided[name] = _coerce(val, ptypes[name]); i += 1
    obj = {n: provided[n] for n, _ in params if n in provided}
    _emit_call(prof, args.module, args.method, [json.dumps(obj)] if obj else [], dry)

def cmd_watch(prof, args):
    # stream events — inherit stdio so it's live
    e = lc_env(prof)
    subprocess.run([LOGOSCORE, "watch", args.module], env=e)

def cmd_telemetry(prof, args):
    # Capture loam-telemetry: subscribe the telemetry topic on a delivery-capable module, then pipe its
    # event stream into loam-telemetry-exporter.mjs, which decodes (with the pre-shared secret) and serves
    # Prometheus /metrics. Prometheus scrapes :port/metrics → Grafana compares Android/Basecamp nodes.
    secret = args.secret or os.environ.get("TELEMETRY_SECRET") or die("--secret (or TELEMETRY_SECRET env) required")
    exporter = args.exporter or os.environ.get("LOAM_TELEMETRY_EXPORTER") or die("--exporter <path to loam-telemetry-exporter.mjs> (or LOAM_TELEMETRY_EXPORTER env) required")
    node = os.environ.get("NODE", "node")
    exp_env = {**os.environ, "TELEMETRY_SECRET": secret}
    topic = subprocess.run([node, exporter, "--topic"], env=exp_env, capture_output=True, text=True).stdout.strip()
    if not topic.startswith("/loam-telemetry/"):
        die("could not derive the telemetry topic — is node + @noble reachable? (run the exporter from an app dir, or set NODE)")
    print(f"[telemetry] topic {topic}")
    lc(prof, "call", args.module, args.subscribe, topic)   # subscribe (empty return reads as error; ignore)
    print(f"[telemetry] {args.module}.{args.subscribe}(topic) sent")
    # PULL, not watch: poll a drainable receive log via `call` — the headless-hub event stream to
    # loam_core isn't observable, but a plain `call` is. Each poll's frames feed the exporter's stdin.
    exp = subprocess.Popen([node, exporter, f"--port={args.port}"], env=exp_env, stdin=subprocess.PIPE, text=True)
    print(f"[telemetry] exporter on :{args.port}/metrics — polling {args.module}.{args.collect} every {args.interval}s. Ctrl-C to stop.")
    try:
        while True:
            r = lc(prof, "call", args.module, args.collect)
            out = (r.stdout or "").strip()
            if out and out not in ("[]", "null", ""):
                try: exp.stdin.write(out + "\n"); exp.stdin.flush()
                except Exception: break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    finally:
        try: exp.terminate()
        except Exception: pass

def cmd_profiles(_prof, _args):
    seen = set()
    for d in PROFILE_DIRS:
        if d.exists():
            for f in sorted(d.glob("*.json")):
                if f.stem not in seen:
                    seen.add(f.stem)
                    try: desc = json.loads(f.read_text()).get("description", "")
                    except Exception: desc = ""
                    print(f"  {f.stem:16} {desc}")
    if not seen: print("  (no profiles; add one under ./profiles or ~/.logos-hub/profiles)")

SUBCOMMANDS = ["up", "down", "status", "ls", "logs", "describe", "call", "watch",
               "telemetry", "profiles", "completions"]

def _profile_names():
    names = set()
    for d in PROFILE_DIRS:
        if d.exists():
            for f in d.glob("*.json"): names.add(f.stem)
    return sorted(names)

def cmd_complete(_prof, a):
    """Machine-readable candidate lists for the bash-completion function (one per line)."""
    what, rest = a.what, list(a.rest)
    if what == "subcommands": return print("\n".join(SUBCOMMANDS))
    if what == "profiles":    return print("\n".join(_profile_names()))
    if not rest: return
    prof = find_profile(rest[0])
    if what == "modules":
        try:
            d = json.loads(lc(prof, "list-modules", "--json").stdout)
            return print("\n".join(m["name"] for m in d))
        except Exception:
            return print("\n".join(prof.get("load", [])))
    if what == "methods" and len(rest) >= 2:
        return print("\n".join(sorted(module_schema(prof, rest[1]).keys())))
    if what == "params" and len(rest) >= 3:
        sc = module_schema(prof, rest[1]).get(rest[2], [])
        return print("\n".join(f"--{n}" for n, _ in sc))

def cmd_completions(_prof, _a):
    """Print a bash-completion script. Install: `logos-hub completions > /etc/bash_completion.d/logos-hub`
    or `source <(logos-hub completions)`."""
    print(r'''# bash completion for logos-hub — dynamic, driven by `logos-hub complete ...`
_logos_hub() {
  local cur prev cword words hub sub
  cur="${COMP_WORDS[COMP_CWORD]}"; cword=$COMP_CWORD; words=("${COMP_WORDS[@]}"); hub="${words[0]}"
  if [ "$cword" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$("$hub" complete subcommands 2>/dev/null)" -- "$cur")); return
  fi
  sub="${words[1]}"
  case "$sub" in
    up|down|status|ls|logs|describe|watch|call|telemetry)
      [ "$cword" -eq 2 ] && { COMPREPLY=($(compgen -W "$("$hub" complete profiles 2>/dev/null)" -- "$cur")); return; } ;;
  esac
  case "$sub" in
    describe|watch)
      [ "$cword" -eq 3 ] && { COMPREPLY=($(compgen -W "$("$hub" complete modules "${words[2]}" 2>/dev/null)" -- "$cur")); return; } ;;
    call)
      local pf="${words[2]}" mod="${words[3]}" meth="${words[4]}"
      [ "$cword" -eq 3 ] && { COMPREPLY=($(compgen -W "$("$hub" complete modules "$pf" 2>/dev/null)" -- "$cur")); return; }
      [ "$cword" -eq 4 ] && { COMPREPLY=($(compgen -W "$("$hub" complete methods "$pf" "$mod" 2>/dev/null)" -- "$cur")); return; }
      [ "$cword" -ge 5 ] && { COMPREPLY=($(compgen -W "$("$hub" complete params "$pf" "$mod" "$meth" 2>/dev/null)" -- "$cur")); return; } ;;
  esac
}
complete -F _logos_hub logos-hub''')

def main():
    ap = argparse.ArgumentParser(prog="logos-hub", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    def prof_arg(sp): sp.add_argument("profile", help="profile name (see `logos-hub profiles`)")
    for name, help in [("up","start the daemon + load the profile's modules"),
                       ("down","stop the profile's daemon"),
                       ("status","daemon + module health"),
                       ("ls","list loaded/available modules"),
                       ("logs","tail the daemon log")]:
        sp = sub.add_parser(name, help=help); prof_arg(sp)
    sp = sub.add_parser("describe", help="show a module's API (methods) from module-info"); prof_arg(sp); sp.add_argument("module"); sp.add_argument("--json", action="store_true", help="dump the full machine-readable schema (for agents/tooling)")
    sp = sub.add_parser("call", help="call a method: --name value (typed from module-info) or a raw JSON positional")
    prof_arg(sp); sp.add_argument("--dry-run", action="store_true", help="print the JSON that would be sent, don't invoke"); sp.add_argument("module"); sp.add_argument("method"); sp.add_argument("args", nargs=argparse.REMAINDER)
    sub.add_parser("completions", help="print a bash-completion script (source <(logos-hub completions))")
    sp = sub.add_parser("complete", help="(internal) candidate lists for shell completion")
    sp.add_argument("what"); sp.add_argument("rest", nargs="*")
    sp = sub.add_parser("watch", help="stream a module's events"); prof_arg(sp); sp.add_argument("module")
    sp = sub.add_parser("telemetry", help="subscribe the telemetry topic → serve Prometheus /metrics"); prof_arg(sp)
    sp.add_argument("--secret", help="pre-shared loam-telemetry secret (or TELEMETRY_SECRET env)")
    sp.add_argument("--exporter", help="path to loam-telemetry-exporter.mjs (or LOAM_TELEMETRY_EXPORTER env)")
    sp.add_argument("--module", default="loam_core", help="delivery-capable module that receives telemetry (default: loam_core)")
    sp.add_argument("--subscribe", default="join", help="subscribe method on the module (loam_core: join; delivery_module: subscribe)")
    sp.add_argument("--collect", default="recentReceived", help="drainable receive-log method to poll (loam_core: recentReceived)")
    sp.add_argument("--interval", type=float, default=5, help="seconds between recentReceived polls (default 5)")
    sp.add_argument("--port", type=int, default=9109, help="Prometheus /metrics port (default 9109)")
    sub.add_parser("profiles", help="list available profiles")
    a = ap.parse_args()

    if a.cmd == "profiles": return cmd_profiles(None, a)
    if a.cmd == "completions": return cmd_completions(None, a)
    if a.cmd == "complete": return cmd_complete(None, a)
    prof = find_profile(a.profile)
    {"up":cmd_up,"down":cmd_down,"status":cmd_status,"ls":cmd_ls,"logs":cmd_logs,
     "describe":cmd_describe,"call":cmd_call,"watch":cmd_watch,"telemetry":cmd_telemetry}[a.cmd](prof, a)

if __name__ == "__main__":
    main()
